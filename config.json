{
  "project": {
    "name": "AI与材料知识图谱文献日报",
    "timezone": "Asia/Shanghai"
  },
  "window": {
    "days": 3,
    "max_catchup_days": 30,
    "max_items_per_journal": 60,
    "workers": 6,
    "rss_timeout_seconds": 25,
    "api_timeout_seconds": 45,
    "retries": 2,
    "sources": {
      "rss": true,
      "openalex": true,
      "crossref": true
    }
  },
  "output": {
    "dir": "reports",
    "keep_days": 365,
    "max_entries": 10,
    "open_after_run": false,
    "write_json_snapshot": true,
    "source_status": "summary",
    "frontmatter": true,
    "cards": true,
    "cards_html": "docs/index.html"
  },
  "keywords": [
    {
      "label": "构效关系与AI",
      "weight": 3,
      "main": true,
      "terms": [
        "structure-property",
        "structure–property",
        "machine learning",
        "materials informatics",
        "graph neural network",
        "explainable artificial intelligence",
        "inverse design",
        "active learning"
      ]
    },
    {
